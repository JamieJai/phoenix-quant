# .env.example
# 이 파일을 .env로 복사한 뒤 실제 값을 넣으세요.
# 절대 GitHub에 올리지 마세요.

TELEGRAM_BOT_TOKEN=여기에_봇토큰
TELEGRAM_CHAT_ID=여기에_챗아이디

# Intraday feature accumulation
PHOENIX_INTRADAY_FEATURE_CACHE=1
PHOENIX_INTRADAY_FEATURE_CACHE_PATH=data/intraday_features.csv

# /top overlay only: keeps daily ranking summary unchanged; reranks only the separate Intraday Overlay block.
PHOENIX_INTRADAY_OVERLAY_RERANK=1

# /toplive, /hot, and shadow-compare candidate pool. Do not use 별도 top intraday rerank 변수.
PHOENIX_TOP_CANDIDATE_N=50
PHOENIX_HOT_INTRADAY_MIN_SCORE=55
PHOENIX_TOP_SHADOW_LOG_DIR=results/top_shadow_compare

# Daily alert defaults
PHOENIX_DAILY_HOUR=18
PHOENIX_DAILY_LABEL=18:00 Daily Top
PHOENIX_DAILY_INTRADAY_OVERLAY=0
PHOENIX_DAILY_SEND_ONLY_AT_CONFIGURED_HOUR=1
