# Copy to config/phoenix_auto_cycle.env and adjust for the deployment host.
#
# This cycle validates and promotes Telegram reference candidate models/rules only.
# It does not place trades or add automatic trading behavior.

PHOENIX_ROOT_DIR=/home/sysadmin/phoenix_ai_core_mvp
PHOENIX_CONFIG=config/config.yaml
PHOENIX_PYTHON=/home/sysadmin/phoenix_ai_core_mvp/.venv/bin/python

PHOENIX_TOP_N=5
PHOENIX_MAIN_PERIOD=3y
PHOENIX_BENCHMARK_PERIOD=5y
PHOENIX_BENCHMARK_FREQUENCY=monthly

PHOENIX_TRAIN_START=2023-01-01
PHOENIX_TRAIN_END=2024-12-20
PHOENIX_TEST_START=2025-01-16
PHOENIX_TEST_END=2026-07-06
PHOENIX_EMBARGO_TRADING_DAYS=10
PHOENIX_MAX_TEST_END_LAG_DAYS=14

PHOENIX_RANDOM_BASELINE=1000
PHOENIX_BOOTSTRAP=1000
PHOENIX_TRAIN_TOP_K_RULES=5
PHOENIX_RANK_MODE=decision
PHOENIX_XGB_BLEND_WEIGHT=0.0

PHOENIX_MIN_DOLLAR_VOLUME=10000000
PHOENIX_MIN_PRICE=5
PHOENIX_MAX_GAP_OPEN=0.08
PHOENIX_ENTRY_PENALTY_BPS=20

PHOENIX_MODELS_ROOT=models
PHOENIX_CANDIDATES_ROOT=models/candidates
PHOENIX_CURRENT_DIR=models/current
PHOENIX_ARCHIVE_ROOT=models/archive

PHOENIX_MIN_SAMPLE_SIZE=50
PHOENIX_MIN_PORTFOLIO_DELTA=0.001
PHOENIX_MAX_P_VALUE=0.20
PHOENIX_MAX_MDD_SLIPPAGE=0.02
PHOENIX_MIN_ACTIVE_TRADES=30
PHOENIX_ALLOW_INITIAL_PROMOTION=1
PHOENIX_ALLOW_XGB_PROMOTION=0
PHOENIX_REQUIRE_LEAKAGE_AUDIT=1

# Rolling OOS is expensive. Enable it for stricter promotion gates.
PHOENIX_REQUIRE_ROLLING_OOS=1
PHOENIX_MIN_ROLLING_SPLITS=2
PHOENIX_MIN_ROLLING_PASS_RATE=1.0
PHOENIX_ROLLING_MIN_ALPHA=0.0
PHOENIX_ROLLING_MAX_P_VALUE=0.20
PHOENIX_ROLLING_MAX_MDD=0.20
PHOENIX_ROLLING_SPLITS="split_2024:2022-01-03,2023-12-15,2024-01-08,2024-12-20;split_2025_2026:2023-01-01,2024-12-20,2025-01-16,2026-07-06"

PHOENIX_BOT_SERVICE=phoenix-telegram-bot.service
PHOENIX_RESTART_BOT_ON_PROMOTION=0
PHOENIX_LOG_FILE=/home/sysadmin/phoenix_ai_core_mvp/logs/phoenix_auto_validation.log
PHOENIX_LOCK_FILE=/home/sysadmin/python-stock/run/locks/phoenix-weekly-auto-cycle.lock
# Set to 1, or create PHOENIX_PAUSE_FILE, to make scheduled cycles exit early.
PHOENIX_AUTO_CYCLE_DISABLED=0
PHOENIX_PAUSE_FILE=/home/sysadmin/phoenix_ai_core_mvp/.phoenix_auto_cycle.pause
