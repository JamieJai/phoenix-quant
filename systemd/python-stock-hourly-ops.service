[Unit]
Description=Python Stock hourly operational refresh, paper, and health cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/sysadmin/phoenix_ai_core_mvp
ExecStart=/home/sysadmin/phoenix_ai_core_mvp/scripts/phoenix_hourly_ops.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
