[Unit]
Description=Phoenix Toss US extended-hours research backfill batch
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/sysadmin/phoenix_ai_core_mvp
Nice=10
IOSchedulingClass=idle
ExecStart=/home/sysadmin/phoenix_ai_core_mvp/.venv/bin/python /home/sysadmin/phoenix_ai_core_mvp/scripts/phoenix_toss_us_extended_hours_backfill.py --max-ticker-dates 60 --request-spacing 0.20
