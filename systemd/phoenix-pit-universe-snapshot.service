[Unit]
Description=Phoenix immutable US PIT universe research snapshot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/sysadmin/phoenix_ai_core_mvp
ExecStart=/home/sysadmin/phoenix_ai_core_mvp/.venv/bin/python /home/sysadmin/phoenix_ai_core_mvp/scripts/phoenix_pit_universe_snapshot.py
