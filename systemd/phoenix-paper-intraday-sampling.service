[Unit]
Description=Collect Phoenix frozen-universe intraday paper shadow rows
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/sysadmin/phoenix_ai_core_mvp
Nice=10
IOSchedulingClass=idle
ExecStart=/home/sysadmin/phoenix_ai_core_mvp/.venv/bin/python /home/sysadmin/phoenix_ai_core_mvp/scripts/phoenix_intraday_shadow_collector.py
