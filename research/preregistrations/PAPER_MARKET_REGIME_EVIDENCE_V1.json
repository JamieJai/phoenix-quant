    "relative_return_vs_soxx_pct": "sector_rs_soxx_pct"
  },
  "formula": {
    "qqq_return_10m_pct": "stock_return_10m_pct - relative_return_vs_qqq_pct",
    "smh_return_10m_pct": "stock_return_10m_pct - relative_return_vs_smh_pct",
    "soxx_return_10m_pct": "stock_return_10m_pct - relative_return_vs_soxx_pct",
    "semi_return_10m_pct": "(smh_return_10m_pct + soxx_return_10m_pct) / 2",
    "risk_on": "qqq_return_10m_pct >= 0.20 and semi_return_10m_pct >= 0.20",
    "risk_off": "qqq_return_10m_pct <= -0.20 and semi_return_10m_pct <= -0.20",
    "mixed": "all other complete observations",
    "unknown": "any required input missing or timestamp not timezone-aware"
  },
  "timestamp_contract": {
    "feature_available_at": "source intraday row timestamp",
    "all_inputs_available_by_feature_time": true,
    "timezone_required": true,
    "storage_timezone": "UTC",
    "market_date_timezone": "America/New_York",
    "lookahead_rows_excluded": true
  },
  "missing_policy": {
    "imputation": "NONE",
    "unknown_is_eligible": false,
    "naive_timestamp_is_prospective": false
  },
  "acceptance_gate": {
